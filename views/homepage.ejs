<% layout("/layouts/boilerplate.ejs") %>

<!-- 1. Hero Section -->
<div
  class="p-5 mb-5 rounded-4 bg-light border shadow-sm text-center py-5 my-3 position-relative overflow-hidden"
>
  <div class="col-lg-8 mx-auto py-4">
    <h1 class="display-4 fw-bold text-dark mb-3">
      Don't Just Visit a Place. <br />
      <span class="atithi-red">Live Its Living Heritage.</span>
    </h1>
    <p class="lead text-muted mb-4 px-md-4">
      Atithi bridges travelers with native ancestral homes across India.
      Experience hand-pounded regional cuisines, vernacular architecture, and
      sacred traditions directly with local families.
    </p>
    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
      <a
        href="/listings"
        class="btn btn-search btn-lg px-4 gap-3 fw-medium shadow-sm"
        >Explore Cultural Stays</a
      >
      <a
        href="/listings/new"
        class="btn btn-outline-secondary btn-lg px-4 fw-medium"
        >Host Your Ancestral Home</a
      >
    </div>
  </div>
</div>

<!-- 2. Mission / Motivation Section -->
<div class="container my-5 py-4">
  <div class="row align-items-center g-5">
    <div class="col-lg-6">
      <h6 class="text-uppercase atithi-red fw-bold letter-spacing-1">
        Our Motivation
      </h6>
      <h2 class="fw-bold mb-3">
        Tourism That Preserves History Instead of Diluting It
      </h2>
      <p class="text-secondary leading-relaxed">
        Modern commercial tourism often pushes authentic indigenous traditions
        to the margins, turning ancient towns into homogenized resort strips.
        Outsiders miss the authentic stories, while the keepers of regional
        heritage see little direct economic benefit.
      </p>
      <p class="text-secondary leading-relaxed">
        <strong>Atithi</strong> was built to make native traditions accessible
        to curious travelers while directing tourism revenue directly into rural
        households. When travelers value traditional vernacular architecture,
        regional grain farming, and artisan crafts, communities gain a
        sustainable incentive to safeguard their ancestral heritage for
        generations to come.
      </p>
    </div>
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <blockquote class="blockquote mb-0">
          <p class="fs-5 fst-italic text-dark mb-3">
            "When an ancestral mud house earns respect and livelihood, it isn't
            replaced by concrete. Culture survives when the community thrives."
          </p>
          <footer class="blockquote-footer atithi-red mt-2">
            The Atithi Philosophy
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</div>

<!-- 3. The 3 Pillars -->
<div class="container my-5 py-4">
  <div class="text-center mb-5">
    <h6 class="text-uppercase atithi-red fw-bold">The Experience</h6>
    <h2 class="fw-bold">What You Experience With Atithi</h2>
  </div>

  <div class="row g-4">
    <!-- Pillar 1 -->
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4">
        <div class="fs-1 text-primary mb-3">
          <i class="fa-solid fa-house-chimney atithi-red"></i>
        </div>
        <h4 class="fw-semibold mb-2">Ancestral Architecture</h4>
        <p class="text-muted small">
          Stay in centuries-old timber Kath-Kuni cottages in Himachal,
          deodar-carved Kholis in Kumaon, and stilted bamboo Chang Ghars on the
          Brahmaputra.
        </p>
      </div>
    </div>

    <!-- Pillar 2 -->
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4">
        <div class="fs-1 text-primary mb-3">
          <i class="fa-solid fa-utensils atithi-red"></i>
        </div>
        <h4 class="fw-semibold mb-2">Traditional food</h4>
        <p class="text-muted small">
          Taste heirloom ingredients: slow-roasted iron-pot Bhatt ki Churkani,
          fresh noon chai around a warm bukhari, and banana-leaf steamed coastal
          curries.
        </p>
      </div>
    </div>

    <!-- Pillar 3 -->
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4">
        <div class="fs-1 text-primary mb-3">
          <i class="fa-solid fa-hand-holding-heart atithi-red"></i>
        </div>
        <h4 class="fw-semibold mb-2 ">Local Sightseeing & Folklore</h4>
        <p class="text-muted small">
          Walk hidden village paths with local hosts, discover forgotten folklore by evening hearths, and experience sacred groves and monuments through oral histories.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- 4. Cultural Footprint Banner -->
<div class="container my-5">
  <div class="card bg-dark text-white border-0 rounded-4 p-4 p-md-5 shadow">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h3 class="fw-bold mb-2">Ready to embark on a meaningful journey?</h3>
        <p class="text-white-50 mb-md-0">
          Discover unique regional stays spanning from the walnut valleys of
          Kashmir to the backwaters of Kerala.
        </p>
      </div>
      <div class="col-md-4 text-md-end">
        <a
          href="/listings"
          class="btn btn-light btn-lg px-4 fw-medium shadow-sm"
          >Browse All Stays</a
        >
      </div>
    </div>
  </div>
</div>
