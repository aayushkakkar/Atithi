<% layout("/layouts/boilerplate.ejs") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-md-12">
      <div class="card shadow-sm border-0 p-4 p-md-5">
        <h1 class="mb-2 fw-bold atithi-red">Help/Contact Us</h1>
        <p class="text-muted mb-4">
          Whether you're visiting a village retreat, sharing your ancestral
          home, or experiencing technical hitches—reach out directly to the
          right desk below.
        </p>
        <div class="row g-3 mb-5">
          <!-- 1. Guest Queries -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 h-100 bg-light">
              <div class="d-flex align-items-center mb-2">
                <i class="fa-solid fa-compass atithi-red me-2 fs-5"></i>
                <h5 class="fw-semibold mb-0">Guest Queries</h5>
              </div>
              <p class="small text-muted mb-3">
                Assistance with amenities, local guide connections,
                cancellations, or finding rural village check-ins.
              </p>
              <div class="small">
                <div>
                  <strong>Email:</strong>
                  <a
                    href="mailto:support@atithi.com"
                    class="text-decoration-none"
                    >support@atithi.com</a
                  >
                </div>
                <div>
                  <strong>Helpline:</strong>
                  <a href="tel:+919999999999" class="text-decoration-none"
                    >+91 99999-99999</a
                  >
                </div>
              </div>
            </div>
          </div>
          <!-- 2. Hosting on Atithi -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 h-100 bg-light">
              <div class="d-flex align-items-center mb-2">
                <i
                  class="fa-solid fa-house-chimney-user atithi-red me-2 fs-5"
                ></i>
                <h5 class="fw-semibold mb-0">Hosting on Atithi</h5>
              </div>
              <p class="small text-muted mb-3">
                Guidance for native hosts, haveli keepers, and cultural
                storytellers listing their ancestral homes.
              </p>
              <div class="small">
                <div>
                  <strong>Email:</strong>
                  <a href="mailto:hosts@atithi.com" class="text-decoration-none"
                    >hosts@atithi.com</a
                  >
                </div>
                <div>
                  <strong>Desk:</strong>
                  <a href="tel:+918888888888" class="text-decoration-none"
                    >+91 88888-88888</a
                  >
                </div>
              </div>
            </div>
          </div>
          <!-- 3. Technical Support -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 h-100 bg-light">
              <div class="d-flex align-items-center mb-2">
                <i
                  class="fa-solid fa-screwdriver-wrench atithi-red me-2 fs-5"
                ></i>
                <h5 class="fw-semibold mb-0">Technical Support</h5>
              </div>
              <p class="small text-muted mb-3">
                Report broken links, Mapbox coordinate glitches, image uploads,
                or session login issues.
              </p>
              <div class="small">
                <div>
                  <strong>Email:</strong>
                  <a href="mailto:tech@atithi.com" class="text-decoration-none"
                    >tech@atithi.com</a
                  >
                </div>
                <div>
                  <strong>GitHub:</strong>
                  <a
                    href="https://github.com/aayushkakkar"
                    target="_blank"
                    class="text-decoration-none"
                    >Report Issue</a
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- 4. Collaborations & Media -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 h-100 bg-light">
              <div class="d-flex align-items-center mb-2">
                <i class="fa-solid fa-handshake atithi-red me-2 fs-5"></i>
                <h5 class="fw-semibold mb-0">Collaborations & Media</h5>
              </div>
              <p class="small text-muted mb-3">
                Partner with us on regional tourism initiatives, heritage
                conservation, or cultural documentation.
              </p>
              <div class="small">
                <div>
                  <strong>Email:</strong>
                  <a
                    href="mailto:partners@atithi.com"
                    class="text-decoration-none"
                    >partners@atithi.com</a
                  >
                </div>
                <div>
                  <strong>Press:</strong>
                  <a href="mailto:media@atithi.com" class="text-decoration-none"
                    >media@atithi.com</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <hr class="my-4" />

        <h3 class="fw-bold mb-2 text-center">
          Prefer to drop a quick message?
        </h3>
        <p class="text-muted small text-center mb-4">
          Fill out the form below and our team will get back to you within 24–48
          hours.
        </p>
        <form
          action="/help/contact"
          method="POST"
          class="needs-validation"
          novalidate
        >
          <div class="mb-3">
            <label for="name" class="form-label">Please enter your name</label>
            <input
              name="contact[name]"
              class="form-control"
              required
              id="name"
            />
            <div class="invalid-feedback">Please enter your name</div>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Enter your e-mail</label>
            <input
              type="email"
              class="form-control"
              name="contact[email]"
              required
              id="email"
            />
            <div class="valid-feedback">E-mail looks good!</div>
          </div>
          <div class="mb-3">
            <label for="message" class="form-label">Enter your message</label>
            <textarea
              name="contact[message]"
              class="form-control"
              required
              id="message"
              rows="4"
            ></textarea>
            <div class="invalid-feedback">Please write a short message</div>
          </div>
          <div class="mb-3">
            <label for="topic" class="form-label">Subject</label>
            <select
              class="form-select"
              name="contact[topic]"
              required
              id="topic"
            >
              <option selected disabled value="">Select an Inquiry type</option>
              <option value="hosting">Listing a Homestay</option>
              <option value="guest">Guest / Experience Support</option>
              <option value="bug">Platform Bug / Issue</option>
              <option value="other">Other</option>
            </select>
            <div class="invalid-feedback">Please select a topic</div>
          </div>

          <button class="btns">Submit</button>
        </form>

        <!-- Footer link back -->
        <div class="mt-5 pt-3 border-top d-flex justify-content-between align-items-center">
          <a href="/listings" class="btn btn-search btn-sm">&larr; Back to Listings</a>
          <span class="text-muted small">&copy; 2026 Atithi. All rights reserved.</span>
        </div>
      </div>
    </div>
  </div>
</div>
